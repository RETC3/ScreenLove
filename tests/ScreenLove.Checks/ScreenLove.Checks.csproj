<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controlli automatici delle funzioni di ScreenLove che non richiedono clic:
       effetti immagine, documenti, taglio/unione video, tasti rapidi, impostazioni.
       Esecuzione: vedi il README (dotnet run, progetto tests/ScreenLove.Checks) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenLove\ScreenLove.csproj" />
  </ItemGroup>

</Project>
