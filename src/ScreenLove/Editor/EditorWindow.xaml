<Window x:Class="ScreenLove.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenLove.Editor"
        Title="ScreenLove — Editor" Width="1240" Height="820" MinWidth="760" MinHeight="420"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <DockPanel>
        <!-- strumenti -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="6,5">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="ToolPanel" Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Select" ToolTip="Seleziona e sposta (V)" Checked="Tool_Checked" Content="↖  Seleziona"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Arrow" ToolTip="Freccia (A) · Maiusc: angoli di 45°" Checked="Tool_Checked" Content="➜  Freccia"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Rectangle" ToolTip="Rettangolo (R) · Maiusc: quadrato" Checked="Tool_Checked" Content="▢  Rettangolo"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Ellipse" ToolTip="Ellisse (E) · Maiusc: cerchio" Checked="Tool_Checked" Content="◯  Ellisse"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Highlight" ToolTip="Evidenziatore (H)" Checked="Tool_Checked" Content="▮  Evidenzia"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Text" ToolTip="Testo (T) · Invio per confermare, Maiusc+Invio per andare a capo" Checked="Tool_Checked" Content="T  Testo"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Step" ToolTip="Passaggi numerati (N)" Checked="Tool_Checked" Content="①  Step"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Blur" ToolTip="Sfoca / pixela dati sensibili (B)" Checked="Tool_Checked" Content="▦  Sfoca"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Spotlight" ToolTip="Spotlight: oscura il resto (S)" Checked="Tool_Checked" Content="◎  Spotlight"/>
                    <RadioButton GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Crop" ToolTip="Ritaglia (C)" Checked="Tool_Checked" Content="⛶  Ritaglia"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTip="Annulla (Ctrl+Z)" Content="↶"/>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Click="Redo_Click" ToolTip="Ripeti (Ctrl+Y)" Content="↷"/>
                    <Button Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="Copia negli appunti (Ctrl+C)" Content="Copia"/>
                    <Button Style="{StaticResource ToolButton}" Click="SaveAs_Click" ToolTip="Salva come… (Ctrl+Maiusc+S)" Content="Salva come"/>
                    <Button Style="{StaticResource AccentButton}" Click="Save_Click" ToolTip="Salva (Ctrl+S)" Content="Salva"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- proprietà -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="10,5"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Colore" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <StackPanel x:Name="PalettePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                <TextBlock Text="Spessore" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="20,0,8,0"/>
                <Slider x:Name="ThicknessSlider" Width="150" Minimum="1" Maximum="12" Value="4" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Thickness_Changed"/>
                <TextBlock x:Name="ThicknessText" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="24"/>
                <Button Style="{StaticResource ToolButton}" Click="DeleteSelected_Click" Margin="20,0,0,0" ToolTip="Elimina l'elemento selezionato (Canc)" Content="Elimina elemento"/>
            </StackPanel>
        </Border>

        <!-- barra di stato -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,3"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Padding="8,2" Click="ZoomOut_Click" Content="−"/>
                    <Button Style="{StaticResource ToolButton}" Padding="8,2" Click="ZoomFit_Click" Content="Adatta"/>
                    <Button Style="{StaticResource ToolButton}" Padding="8,2" Click="Zoom100_Click" Content="100%"/>
                    <Button Style="{StaticResource ToolButton}" Padding="8,2" Click="ZoomIn_Click" Content="+"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- area di lavoro -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource CanvasBrush}" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Image x:Name="BaseImage" Stretch="Fill"/>
                <local:AnnotationLayer x:Name="Layer"/>
                <Canvas x:Name="TextCanvas"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
