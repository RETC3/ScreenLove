<Window x:Class="ScreenLove.Video.VideoTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLove — Taglia video" Width="1000" Height="700" MinWidth="620" MinHeight="420"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="12,8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- linea del tempo: la zona evidenziata è quella che verrà tenuta -->
                <Grid Margin="0,0,0,6">
                    <Canvas x:Name="RangeCanvas" Height="6" VerticalAlignment="Center" IsHitTestVisible="False" Margin="5,0">
                        <Rectangle x:Name="RangeRect" Height="6" Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3" Opacity="0.75"/>
                    </Canvas>
                    <Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            ValueChanged="Timeline_ValueChanged" PreviewMouseDown="Timeline_MouseDown" PreviewMouseUp="Timeline_MouseUp"/>
                </Grid>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource ToolButton}" Click="Close_Click" Content="Chiudi"/>
                        <Button Style="{StaticResource AccentButton}" Click="Save_Click" x:Name="SaveButton" Content="Salva come nuovo video"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Click="Play_Click" x:Name="PlayButton" Content="▶" ToolTip="Riproduci / pausa (Spazio)" MinWidth="40"/>
                        <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="6,0,16,0" MinWidth="110"/>
                        <Button Style="{StaticResource ToolButton}" Click="SetStart_Click" Content="[ Inizio qui" ToolTip="Il video tagliato inizierà da questo punto (I)"/>
                        <Button Style="{StaticResource ToolButton}" Click="SetEnd_Click" Content="Fine qui ]" ToolTip="Il video tagliato finirà in questo punto (O)"/>
                        <TextBlock x:Name="RangeText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <Grid Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
        </Grid>
    </DockPanel>
</Window>
