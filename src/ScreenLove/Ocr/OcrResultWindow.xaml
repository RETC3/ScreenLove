<Window x:Class="ScreenLove.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLove — Testo riconosciuto" Width="980" Height="560" MinWidth="560" MinHeight="320"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <DockPanel>
        <!-- intestazione -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="12,8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Lingua" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguageBox" Width="200" DisplayMemberPath="Name" SelectionChanged="Language_Changed"/>
                </StackPanel>
                <TextBlock Text="Testo riconosciuto" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- azioni -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,6"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Click="OneLine_Click" ToolTip="Unisce le righe in un unico paragrafo" Content="Unisci righe"/>
                    <Button Style="{StaticResource ToolButton}" Click="Close_Click" Content="Chiudi"/>
                    <Button Style="{StaticResource AccentButton}" Click="Copy_Click" Content="Copia testo"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- anteprima della zona -->
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="6">
                <Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <DockPanel Grid.Column="2">
                <!-- codici QR / a barre trovati -->
                <ItemsControl x:Name="CodesList" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2C2F36" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource ToolButton}" Click="OpenLink_Click" Tag="{Binding Text}" Content="Apri link"
                                                Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Style="{StaticResource ToolButton}" Click="CopyCode_Click" Tag="{Binding Text}" Content="Copia"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Format}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="ResultText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="14" Padding="8"
                         Background="#15161A" Foreground="{StaticResource FgBrush}" CaretBrush="White"
                         BorderBrush="{StaticResource LineBrush}" SelectionBrush="{StaticResource AccentBrush}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
