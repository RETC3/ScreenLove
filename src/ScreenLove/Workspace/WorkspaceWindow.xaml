<Window x:Class="ScreenLove.Workspace.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLove — Workspace" Width="980" Height="640" MinWidth="520" MinHeight="360"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Piccolo pulsante a icona nella scheda di una cattura -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="8,6"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource AccentButton}" Click="CaptureRegion_Click" ToolTip="Stamp">
                        <TextBlock Text="＋  Cattura area"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="CaptureFull_Click" ToolTip="Ctrl+Stamp" Content="Schermo"/>
                    <Button Style="{StaticResource ToolButton}" Click="CaptureScrolling_Click" ToolTip="Ctrl+Maiusc+Stamp" Content="Scorrimento"/>
                    <Button Style="{StaticResource ToolButton}" Click="RecordVideo_Click" ToolTip="Ctrl+Alt+R · avvia o ferma" x:Name="RecordButton" Content="● Video"/>
                    <Button Style="{StaticResource ToolButton}" Click="CaptureText_Click" ToolTip="Ctrl+Alt+Stamp · riconosce testo e QR code" Content="Testo"/>
                    <Button Style="{StaticResource ToolButton}" Click="CaptureDelayed_Click" ToolTip="Maiusc+Stamp" x:Name="DelayButton" Content="Ritardo"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Click="Edit_Click" ToolTip="Immagini: editor · video: taglio" Content="Modifica"/>
                    <Button Style="{StaticResource ToolButton}" Click="Copy_Click" Content="Copia"/>
                    <Button Style="{StaticResource ToolButton}" Click="Delete_Click" Content="Elimina"/>
                    <Button Style="{StaticResource ToolButton}" Click="More_Click" x:Name="MoreButton" Content="Altro ▾">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Crea documento (PDF, Word, HTML)…" Click="CreateDocument_Click"/>
                                <MenuItem Header="Estrai testo (OCR)" Click="ExtractText_Click"/>
                                <Separator/>
                                <MenuItem Header="Taglia video…" Click="TrimVideo_Click"/>
                                <MenuItem Header="Unisci i video selezionati…" Click="MergeVideos_Click"/>
                                <Separator/>
                                <MenuItem Header="Apri la cartella delle catture" Click="OpenFolder_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Impostazioni" Content="⚙" FontSize="15"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,5"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="8"
                     SelectionMode="Extended" Foreground="{StaticResource FgBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove"
                     KeyDown="List_KeyDown"
                     SelectionChanged="List_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card" CornerRadius="8" Padding="8" Background="#24262C"
                                            BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="#2C2F36"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="200" ToolTip="{Binding Path}">
                            <Border Height="128" Background="{StaticResource CanvasBrush}" CornerRadius="5">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- simbolo dei video -->
                                    <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                            Width="40" Height="40" CornerRadius="20" Background="#CC1E1F24"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="▶" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,1"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,5,0,0">
                                <!-- tasti rapidi della singola cattura -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource CardButton}" Click="ItemCopy_Click"
                                            ToolTip="Copia (Ctrl+C)" Content="&#xE8C8;"/>
                                    <Button Style="{StaticResource CardButton}" Click="ItemSaveAs_Click"
                                            ToolTip="Salva con nome…" Content="&#xE74E;"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Margin="2,2,2,0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Info}" Margin="2,2,2,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Modifica" Click="Edit_Click" InputGestureText="Invio"/>
                        <MenuItem Header="Estrai testo (OCR)" Click="ExtractText_Click"/>
                        <MenuItem Header="Crea documento…" Click="CreateDocument_Click"/>
                        <MenuItem Header="Taglia video…" Click="TrimVideo_Click"/>
                        <MenuItem Header="Unisci i video selezionati…" Click="MergeVideos_Click"/>
                        <MenuItem Header="Copia immagine" Click="Copy_Click" InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Copia percorso" Click="CopyPath_Click"/>
                        <MenuItem Header="Mostra in Esplora risorse" Click="ShowInExplorer_Click"/>
                        <Separator/>
                        <MenuItem Header="Elimina (Cestino)" Click="Delete_Click" InputGestureText="Canc"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="♥" FontSize="54" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nessuna cattura per ora" FontSize="18" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock Text="Premi Stamp per catturare un'area o una finestra" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Pannello di anteprima (Impostazioni → Finestra delle catture) -->
        <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="5" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource LineBrush}" ToolTip="Trascina per allargare l'anteprima"/>
        <Border x:Name="PreviewPanel" Grid.Column="2" Visibility="Collapsed" Background="{StaticResource PanelBrush}">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock x:Name="PreviewName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewInfo" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PreviewHint" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Doppio clic sull'anteprima per aprirla"/>
                </StackPanel>
                <Grid>
                    <Border Background="{StaticResource CanvasBrush}" CornerRadius="6"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"
                           MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="PreviewVideoMark" Visibility="Collapsed" IsHitTestVisible="False"
                            Width="56" Height="56" CornerRadius="28" Background="#CC1E1F24"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="▶" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,2"/>
                    </Border>
                    <TextBlock x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="16" IsHitTestVisible="False"
                               Text="Seleziona una cattura per vederla qui"/>
                </Grid>
            </DockPanel>
        </Border>
        </Grid>
    </DockPanel>
</Window>
