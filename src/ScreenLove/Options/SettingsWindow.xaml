<Window x:Class="ScreenLove.Options.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLove — Impostazioni" Width="720" Height="760" MinWidth="560" MinHeight="420"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15161A"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,6"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Click="Cancel_Click" Content="Annulla"/>
                    <Button Style="{StaticResource AccentButton}" Click="Save_Click" Content="Salva"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,20">
                <TextBlock Style="{StaticResource Section}" Text="Generale"/>
                <TextBlock Style="{StaticResource Label}" Text="Cartella delle catture"/>
                <DockPanel Margin="0,4,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="Browse_Click" Content="Sfoglia…" Margin="6,0,0,0"/>
                    <TextBox x:Name="FolderBox"/>
                </DockPanel>
                <CheckBox x:Name="AutostartBox" Content="Avvia ScreenLove con Windows (nell'area di notifica)"/>

                <TextBlock Style="{StaticResource Section}" Text="Dopo una cattura"/>
                <CheckBox x:Name="CopyBox" Content="Copia l'immagine negli appunti"/>
                <CheckBox x:Name="WorkspaceBox" Content="Mostra il workspace con la nuova cattura"/>
                <CheckBox x:Name="EditorBox" Content="Apri subito l'editor"/>

                <TextBlock Style="{StaticResource Section}" Text="Cattura"/>
                <CheckBox x:Name="CursorBox" Content="Includi il cursore nelle catture a schermo intero"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="Ritardo della cattura con ritardo:" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DelayBox" Width="90"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Video"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Label}" Text="Fotogrammi al secondo:" Margin="0,0,10,0"/>
                    <ComboBox x:Name="FpsBox" Width="90"/>
                </StackPanel>
                <CheckBox x:Name="SysAudioBox" Content="Registra l'audio di sistema"/>
                <CheckBox x:Name="MicBox" Content="Registra il microfono"/>
                <CheckBox x:Name="RecCursorBox" Content="Mostra il cursore nel video"/>
                <CheckBox x:Name="WebcamBox" Content="Mostra la webcam (bolla nell'angolo della zona registrata)"/>

                <TextBlock Style="{StaticResource Section}" Text="Editor"/>
                <TextBlock Style="{StaticResource Label}" Text="Testo del watermark"/>
                <TextBox x:Name="WatermarkBox" Margin="0,4,0,0"/>

                <TextBlock Style="{StaticResource Section}" Text="Aggiornamenti"/>
                <CheckBox x:Name="UpdatesBox" Content="Controlla se ci sono nuove versioni (una volta al giorno)"/>
                <CheckBox x:Name="StatsBox" Margin="0,6,0,0"
                          Content="Invia statistiche anonime d'uso (un codice casuale, la versione e il tipo di Windows)"
                          ToolTip="Insieme al controllo degli aggiornamenti: serve solo a contare quante copie di ScreenLove sono in uso. Disattivandola, il codice viene cancellato."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Label}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource ToolButton}" Click="CheckUpdates_Click" Content="Cerca ora"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Tasti rapidi"/>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Clicca su una casella e premi la combinazione desiderata (Canc per nessun tasto). I tasti sono sospesi finché questa finestra è aperta."/>
                <Grid x:Name="HotkeyGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
